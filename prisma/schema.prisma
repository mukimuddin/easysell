generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_users {
  id               Int               @id @default(autoincrement())
  username         String?           @db.VarChar(50)
  password         String?           @db.VarChar(255)
  role             admin_users_role? @default(employee)
  workers          workers[]
  employee_profile employee_details?
}

model employee_details {
  id                         Int         @id @default(autoincrement())
  admin_id                   Int         @unique
  full_name                  String?     @db.VarChar(100)
  father_name                String?     @db.VarChar(100)
  mother_name                String?     @db.VarChar(100)
  phone                      String?     @db.VarChar(20)
  email                      String?     @db.VarChar(100)
  present_address            String?     @db.Text
  permanent_address          String?     @db.Text
  dob                        DateTime?   @db.Date
  nid_no                     String?     @db.VarChar(50)
  joining_date               DateTime?   @db.Date
  designation                String?     @db.VarChar(50)
  basic_salary               Decimal?    @db.Decimal(10, 2)
  contract_target            Int?        @default(0)
  bank_name                  String?     @db.VarChar(100)
  account_no                 String?     @db.VarChar(50)
  emergency_contact_name     String?     @db.VarChar(100)
  emergency_contact_relation String?     @db.VarChar(50)
  emergency_contact_phone    String?     @db.VarChar(20)
  admin_user                 admin_users @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model channels {
  id            Int             @id @default(autoincrement())
  channel_name  String          @db.VarChar(255)
  channel_link  String          @db.Text
  is_selected   Boolean?        @default(false)
  whatsapp      String?         @db.VarChar(50)
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  worker_id     Int?
  open_date     DateTime?       @db.Date
  sell_price    Decimal?        @default(0.00) @db.Decimal(10, 2)
  worker_cost   Decimal?        @default(0.00) @db.Decimal(10, 2)
  is_sold       Boolean?        @default(false)
  created_by    Int?            @default(1)
  gmail         String?         @db.VarChar(255)
  password      String?         @db.VarChar(255)
  worker        workers?        @relation(fields: [worker_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  daily_updates daily_updates[]

  @@index([worker_id])
}

model daily_updates {
  id              Int                   @id @default(autoincrement())
  channel_id      Int
  shorts_uploaded Boolean?              @default(false)
  sub_count       Int?                  @default(0)
  status          daily_updates_status? @default(growing)
  update_date     DateTime?             @default(dbgenerated("'CURRENT_DATE'")) @db.Date
  created_at      DateTime?             @default(now()) @db.Timestamp(0)
  shorts_count    Int?                  @default(0)
  channel         channels              @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([channel_id])
}

model login_attempts {
  id           Int       @id @default(autoincrement())
  ip           String    @db.VarChar(45)
  attempts     Int?      @default(1)
  last_attempt DateTime? @default(now()) @db.Timestamp(0)

  @@index([ip])
}

model workers {
  id         Int          @id @default(autoincrement())
  name       String       @db.VarChar(255)
  whatsapp   String?      @db.VarChar(50)
  created_at DateTime?    @default(now()) @db.Timestamp(0)
  created_by Int?
  channels   channels[]
  creator    admin_users? @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_by])
}

enum admin_users_role {
  admin
  employee
  buyer
}

enum daily_updates_status {
  growing
  flop
  normal
}

model sources {
  id         Int       @id @default(autoincrement())
  caption    String?   @db.Text
  audio      String?   @db.Text
  link       String?   @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
}

model buyer_accounts {
  id          Int                  @id @default(autoincrement())
  full_name   String               @db.VarChar(120)
  company_name String?             @db.VarChar(150)
  phone       String               @db.VarChar(30)
  email       String               @unique @db.VarChar(150)
  password    String               @db.VarChar(255)
  status      buyer_accounts_status @default(pending)
  reviewed_by Int?
  reviewed_at DateTime?            @db.DateTime(0)
  created_at  DateTime?            @default(now()) @db.Timestamp(0)
}

enum buyer_accounts_status {
  pending
  approved
  rejected
}
